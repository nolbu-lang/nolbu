#-----------------------------------------------------------------------
# globals.properties.example
# 로컬 PC 실행용 템플릿입니다.
# 1) 이 파일을 globals.properties 로 복사하세요.
# 2) DB 접속 정보·폴더 경로를 PC 환경에 맞게 수정하세요.
# (globals.properties 는 .gitignore 대상 — GitHub에 올리지 마세요)
#-----------------------------------------------------------------------

Globals.SystemName = \uc608\uc0b0\ud3b8\uc131\uc2ec\uc0ac\uc815\ubcf4\uc2dc\uc2a4\ud15c
Globals.LocalCd = 6260000
Globals.OsType = WINDOWS

Globals.Jndi = JDBC-CUBRID-BCJIS

crypto.hashed.password=
crypto_password.algorithm=SHA-256
crypto.password=

Globals.DbType = cubrid
Globals.DriverClassName=cubrid.jdbc.driver.CUBRIDDriver
# 로컬 DB: localhost / 운영 DB 조회: 99.1.1.39
Globals.Url=jdbc:CUBRID:localhost:33000:bcjis:::?charset=utf8
Globals.UserName = bcjisapp
Globals.Password = bcjisapp00

Globals.fileStorePath=C:/bcjis/upload/
Globals.excelStorePath=C:/bcjis/download/excel/

#-----------------------------------------------------------------------
# AI 예산도우미 챗봇 — 부산시 내부 행정 AI (LLM Studio / HyperCLOVA) 전용
#-----------------------------------------------------------------------
Globals.AiProvider = hyperclova

# LLM Studio budget_search API (내부망)
# POST 본문 필수: user_query, datetime, stream, dialog_history
Globals.ClovaEndpoint = http://99.1.82.207:8080/llm-studio/v1/api/task/generate/syncapi/busan_ai_llm/budget_search
Globals.ClovaTimeoutMs = 120000

# --- RAG 공통 ---
# 심사조서 질문 시 표·상세에 표시할 최대 사업(연도+사업명) 건수
Globals.AiMaxReportBlocks = 100
# 일반 SQL 조회 최대 행 수
Globals.GeminiMaxRows = 200
# (하위호환) 구 설정명이 없으면 AiMaxReportBlocks 값 사용
Globals.GeminiMaxReportBlocks = 100
Globals.AiReportDbOnly = true
# 연도 미지정 시 추가 검색할 이전 연도 수 (운영: 0~1, 개발·전체검색: 4)
Globals.AiNearbyYearCount = 0
# 연도 미지정·인근연도 실패 시 TB_FISYEAR 전체 순차 검색 (운영: false)
Globals.AiSearchAllYearsFallback = false
# 사업명 넓은 검색(요구·검토 CLOB) — 운영 대용량 DB에서는 false (수십 초 지연 원인)
Globals.AiEnableBroadSearch = false
# 재원 조회 배치 크기 (운영 CUBRID)
Globals.AiFrscBatchSize = 100
# 단일 질의 타임아웃(초)
Globals.AiQueryTimeoutSec = 45
# AI 검색 구간별 소요시간 로그 (Tomcat catalina.out)
Globals.AiPerfLog = true
# 내부자료 검색 연도 분할 크기 — 회계년도를 N년 단위로 쪼개 병렬 조회
#  (2013~2026 처럼 구간이 넓을 때 대기시간 단축. 1=연도별, 2~3 권장)
Globals.AiYearChunkSize = 2
# 분할 구간 최대 개수 (DB 부하 상한. 연도 수가 많으면 구간 크기가 자동으로 커진다)
Globals.AiYearMaxChunks = 12
# 내부자료 JSON 내보내기(모바일 뷰어용, 1년 단위). 0 = 한도 없음(필터 전체)
Globals.AiInternalExportMaxRows = 0
Globals.AiInternalExportMaxBiz = 0

# --- 외부자료 (내부검색 체크 미선택 시 LLM 추론) ---
# 관리자 사전등록 URL. 쉼표 또는 줄바꿈으로 복수 지정. 수정 후 WAS 재기동
# Globals.AiExternalSourceUrls = http://intranet.example/budget-guide.html,http://intranet.example/manual.pdf
Globals.AiExternalSourceUrls =
Globals.AiExternalMaxCharsPerSource = 20000
Globals.AiExternalFetchTimeoutMs = 15000

# --- 일반자료검색 ---
# 법제처 Open API OC (신청 승인값)
Globals.AiLawGoKrOc = nolbu0326
Globals.AiLawGoKrBaseUrl = https://www.law.go.kr/DRF/lawSearch.do
Globals.AiLawOrdinOrgCd = 6260000
Globals.AiLawGoKrDisplay = 20
Globals.AiLawGoKrTimeoutMs = 15000
# 부기주무관(시홈페이지) — API 키 발급 후 등록
Globals.AiBugiEndpoint = https://busanai.busan.go.kr/bugi/external-research/government-data
Globals.AiBugiApiKey =
Globals.AiBugiHttpMethod = GET
Globals.AiBugiTimeoutMs = 20000
# 시홈페이지 직접검색(보도자료·고시공고·새소식). WAS→www.busan.go.kr 방화벽 필요
Globals.AiBusanHomepageBaseUrl = https://www.busan.go.kr
Globals.AiBusanHomepageMaxPerBoard = 10
Globals.AiBusanHomepageTimeoutMs = 20000
# 매뉴얼 PDF 저장 경로 / 운영에서는 AdminOnly=true (POW_GR_CD=BC001만 업로드·삭제)
Globals.AiManualStorePath = C:/bcjis/upload/ai-manual/
Globals.AiManualUploadAdminOnly = false
# 예산운용지침 검색·요약 (관련 본문 충실 + 속도)
#  MaxPages / ExcerptChars : 키워드 뒤 기준·금액 문단 확보
#  PromptChars / LlmMaxFiles : LLM 입력 압축(상위 문서만) → 응답 속도
Globals.AiManualMaxPages = 3
Globals.AiManualExcerptChars = 2200
Globals.AiManualSummaryChars = 6500
Globals.AiManualPromptChars = 3600
Globals.AiManualMaxFiles = 4
Globals.AiManualLlmMaxFiles = 2
Globals.AiManualUseLlm = true
Globals.AiManualFuzzyMaxPages = 60
Globals.ClovaStream = false
