#-----------------------------------------------------------------------
# AI 예산도우미 — 운영 서버 globals.properties 추가 항목
# 기존 globals.properties 파일 맨 아래에 아래 블록을 추가하세요.
# (DB 접속 정보 등 기존 설정은 변경하지 않습니다)
#-----------------------------------------------------------------------

Globals.AiProvider = hyperclova

# LLM Studio budget_search API (내부망 — 행정AI 담당부서 제공 URL)
# POST 본문: user_query, datetime, stream(Boolean), dialog_history(String "[]")
Globals.ClovaEndpoint = http://99.1.82.207:8080/llm-studio/v1/api/task/generate/syncapi/busan_ai_llm/budget_search
Globals.ClovaTimeoutMs = 120000

# 심사조서 질문: DB 직접 조립(빠름). true 권장
Globals.AiReportDbOnly = true
Globals.AiMaxReportBlocks = 50

# 운영 검색 속도 (2026-07-08)
# 연도 명시 질의(예: 2026년 …)는 해당 연도만. 미지정 시 인근 연도 확장 없음(0)
Globals.AiNearbyYearCount = 0
Globals.AiSearchAllYearsFallback = false
# CLOB 넓은 검색 OFF — 사업명으로 못 찾을 때만 true
Globals.AiEnableBroadSearch = false
Globals.AiFrscBatchSize = 100
# 단일 질의 타임아웃(초) — 비정상 장시간 CLOB 스캔 방지
Globals.AiQueryTimeoutSec = 45
Globals.AiPerfLog = true
# 장기 회계연도 검색: 2년 단위 분할 병렬 조회 / 최대 12구간
Globals.AiYearChunkSize = 2
Globals.AiYearMaxChunks = 12
# 내부자료 JSON 내보내기(모바일 뷰어용) 상한 — 1년 단위
Globals.AiInternalExportMaxRows = 8000
Globals.AiInternalExportMaxBiz = 2500

# (하위호환) 일반 SQL 조회 최대 행
Globals.GeminiMaxRows = 200
Globals.GeminiMaxReportBlocks = 50

# --- 외부자료 (내부검색 체크 미선택 시 LLM이 읽어 추론) ---
# 관리자 사전등록. 쉼표/줄바꿈 복수 URL. 수정 후 Tomcat 재기동
# Globals.AiExternalSourceUrls = http://intranet.example/budget-guide.html
Globals.AiExternalSourceUrls =
Globals.AiExternalMaxCharsPerSource = 20000
Globals.AiExternalFetchTimeoutMs = 15000

# --- 일반자료검색 ---
# [필수] 법제처 Open API OC — 미설정 시 "법제처 Open API OC 키가 없습니다" 오류
Globals.AiLawGoKrOc = nolbu0326
Globals.AiLawGoKrBaseUrl = https://www.law.go.kr/DRF/lawSearch.do
Globals.AiLawOrdinOrgCd = 6260000
Globals.AiLawGoKrDisplay = 20
Globals.AiLawGoKrTimeoutMs = 15000
Globals.AiLawGoKrBodyTimeoutMs = 25000
Globals.AiBugiEndpoint = https://busanai.busan.go.kr/bugi/external-research/government-data
Globals.AiBugiApiKey =
Globals.AiBugiHttpMethod = GET
Globals.AiBugiTimeoutMs = 20000
# 시홈페이지(보도자료·고시공고·새소식) — WAS→www.busan.go.kr 방화벽 필요
Globals.AiBusanHomepageBaseUrl = https://www.busan.go.kr
Globals.AiBusanHomepageTimeoutMs = 20000
Globals.AiBusanHomepageMaxPerBoard = 10
Globals.AiManualStorePath = C:/bcjis/upload/ai-manual/
# 운영 서버: true (관리권한 BC001만 업로드/삭제). 로컬 테스트: false
Globals.AiManualUploadAdminOnly = true
# 문장형 키워드 유사도 검색·요약 근거 범위 (관련 본문·속도 균형)
Globals.AiManualMaxPages = 3
Globals.AiManualExcerptChars = 2200
Globals.AiManualSummaryChars = 6500
Globals.AiManualPromptChars = 3600
Globals.AiManualMaxFiles = 4
Globals.AiManualLlmMaxFiles = 2
# 예산운용지침: LLM 요약 사용(true 권장). false면 원문 발췌만
Globals.AiManualUseLlm = true
Globals.AiManualFuzzyMaxPages = 60

# LLM Studio: stream=false 권장(동기 응답 속도)
Globals.ClovaStream = false

#-----------------------------------------------------------------------
# 운영 전 확인
# 1) WAS 서버 → 99.1.82.207:8080 네트워크 접근 가능
# 2) WAS → www.law.go.kr / busanai.busan.go.kr 접근 가능
# 3) globals.properties 수정 후 Tomcat 재기동
# 4) 로그인 → AI 예산편성 도우미 → 내부검색 / 일반자료검색 테스트
#-----------------------------------------------------------------------
